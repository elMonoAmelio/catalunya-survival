{
	"appId": "com.monkisoft.andana",
	"appName": "Andana",
	"webDir": "www",
	"ios": {
		"contentInset": "never"
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"SplashScreen": {
			"launchAutoHide": false,
			"launchShowDuration": 0,
			"backgroundColor": "#0a0a0a",
			"showSpinner": false
		}
	},
	"packageClassList": [
		"GeolocationPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"SplashScreenPlugin"
	]
}
