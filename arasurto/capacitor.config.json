{
  "appId": "com.monkisoft.arasurto",
  "appName": "Arasurto",
  "webDir": "www",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 30000,
      "showSpinner": false
    }
  },
  "loggingBehavior": "none"
}
